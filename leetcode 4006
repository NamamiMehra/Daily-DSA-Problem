class Solution {
    public int countValidPrefixes(String s) {
        int count = 0;
       for(int i=1;i<s.length();i++){
           int count0=0;
           int count1=0;
           for(int j=0;j<=i;j++){
              if(s.charAt(j)=='0'){
                  count0++;
              }
               else{
                   count1++;
               }
           }
           int diff = Math.abs(count0-count1);
           if(diff<=1){
               count++;
           }
       }
        return count+1;
    }
}
