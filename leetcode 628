class Solution {
    public int maximumProduct(int[] nums) {
        Arrays.sort(nums);
        int n= nums.length-1;
        int max1 = Integer.MIN_VALUE;
        int largest = nums[nums.length-1];
        int prod = nums[n]*nums[n-1]*nums[n-2];
        int prod2 = nums[0]*nums[1];
        max1 = Math.max(prod,prod2*largest);
        return max1;
    }
}
